# Mentra Environment Variables
# For production builds, use EAS Secrets or eas.json env block

# RevenueCat (get from app.revenuecat.com → API Keys)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=your_revenuecat_apple_key_here

# Google Gemini AI (free — get from aistudio.google.com → API Keys)
EXPO_PUBLIC_GEMINI_KEY=your_gemini_api_key_here
